# ─────────────────────────────────────────────────────────────────────────────
# ECPROJECT — RAILWAY ENV (single service: client + server in one container)
#
# Paste this whole block into Railway → your service → Variables → Raw Editor,
# then fill the REPLACE_ME values. See RAILWAY.md.
#
# A ready-to-paste copy with secrets already generated lives in `.env.railway`
# (gitignored — never committed). Use that one; this is the committed template.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ─── Allowed browser origins (your live domain[s], comma-separated) ──────────
# Required in production: Next.js forwards the site's Origin header when it
# proxies /api to Express, so the live domain must be allowlisted here.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Database — MongoDB Atlas (free M0) ──────────────────────────────────────
# Atlas → Connect → Drivers → copy the string. Keep the /baljyoti db name.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/baljyoti?retryWrites=true&w=majority

# ─── Secrets — generate with: openssl rand -hex 48 ───────────────────────────
JWT_SECRET=REPLACE_WITH_64+_CHAR_RANDOM
SESSION_SECRET=REPLACE_WITH_64+_CHAR_RANDOM

# ─── Client build-time (baked into the Next.js build — MUST exist before deploy)
# Razorpay LIVE public key id (safe to expose). Placeholder => checkout sim mode.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
# Leave BLANK: client uses relative /api (rewrites); server components fall back
# to localhost:5001 in-container. Do not set to your domain.
NEXT_PUBLIC_API_URL=

# ─── OTP — Fast2SMS (DLT). See server/docs/OTP_FAST2SMS_DLT.md ────────────────
# Start with DEV_MOCK_OTP=true (any number accepts DEV_OTP_CODE) until DLT is live.
DEV_MOCK_OTP=true
DEV_OTP_CODE=123456
FAST2SMS_API_KEY=REPLACE_ME
FAST2SMS_SENDER_ID=BALJYT
FAST2SMS_ENTITY_ID=REPLACE_ME
FAST2SMS_DLT_TEMPLATE_ID_EN=REPLACE_ME
FAST2SMS_DLT_TEMPLATE_ID_HI=REPLACE_ME
OTP_LANG=en
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Email — Gmail App Password (or SMTP) ────────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
# Placeholders => simulation mode. Fill LIVE keys to take real payments.
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ─── Do NOT set ──────────────────────────────────────────────────────────────
# PORT      → Railway injects it (public port Next binds to)
# API_PORT  → defaults to 5001 (internal Express port)
