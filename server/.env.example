# ─────────────────────────────────────────────────────────────────────────────
# ECPROJECT — SERVER ENV TEMPLATE
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/baljyoti

# ─── Secrets ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_me
SESSION_SECRET=change_me

# ─── URLs ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# ─── OTP / Mobile Verification (Fast2SMS — DLT route) ────────────────────────
# DEV_MOCK_OTP=true bypasses Fast2SMS and accepts DEV_OTP_CODE. Set false in prod.
# Setup + DLT registration guide: server/docs/OTP_FAST2SMS_DLT.md
DEV_MOCK_OTP=true
DEV_OTP_CODE=123456
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=BALJYT
FAST2SMS_ENTITY_ID=your_dlt_entity_id
FAST2SMS_DLT_TEMPLATE_ID_EN=your_english_template_id
FAST2SMS_DLT_TEMPLATE_ID_HI=your_hindi_template_id
OTP_LANG=en
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Email (optional) ────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
# Placeholder / blank keys => simulation mode. Use test keys for real test flow.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
