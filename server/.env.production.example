# ─────────────────────────────────────────────────────────────────────────────
# ECPROJECT — SERVER PRODUCTION ENV (Hostinger)
# Copy to `server/.env` on the server and fill with REAL values.
# Never commit the filled file. See DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5001

# ─── Database — MongoDB Atlas (recommended over local mongod) ─────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/baljyoti?retryWrites=true&w=majority

# ─── Secrets — generate strong random values! ────────────────────────────────
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64+_CHAR_RANDOM
SESSION_SECRET=REPLACE_WITH_64+_CHAR_RANDOM

# ─── URLs — your live domain ─────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# ─── OTP — Fast2SMS (DLT). See server/docs/OTP_FAST2SMS_DLT.md ────────────────
DEV_MOCK_OTP=false
DEV_OTP_CODE=123456
FAST2SMS_API_KEY=REPLACE_ME
FAST2SMS_SENDER_ID=BALJYT
FAST2SMS_ENTITY_ID=REPLACE_ME
FAST2SMS_DLT_TEMPLATE_ID_EN=REPLACE_ME
FAST2SMS_DLT_TEMPLATE_ID_HI=REPLACE_ME
OTP_LANG=en
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Email — Gmail App Password (or SMTP) ────────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Payments — Razorpay LIVE keys ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
# Optional: set if you configure a Razorpay webhook in the dashboard
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
