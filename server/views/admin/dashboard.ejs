<%- include('header', { path: '/dashboard' , admin: admin, title: 'Dashboard' }) %>

    <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h2 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 0.5rem; color: var(--secondary-color);">Store Analytics</h2>
            <p style="color: var(--text-muted); font-size: 1rem;">Real-time overview of your store's performance.</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button class="btn" style="background: white; border: 1px solid var(--border-color); color: var(--text-muted); padding: 0.65rem 1.25rem;">
                <i class="fas fa-download"></i> Export Report
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-plus"></i> New Product
            </button>
        </div>
    </div>

    <div class="card-grid">
        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <div class="stat-details">
                <h3>Total Orders</h3>
                <div class="value"><%= orderCount %></div>
            </div>
            <div style="position: absolute; right: 0; bottom: 0; opacity: 0.05; font-size: 5rem; transform: translate(20%, 20%);">
                <i class="fas fa-shopping-bag"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-green">
                <i class="fas fa-rupee-sign"></i>
            </div>
            <div class="stat-details">
                <h3>Total Sales</h3>
                <div class="value">₹<%= totalSales.toLocaleString('en-IN') %></div>
            </div>
            <div style="position: absolute; right: 0; bottom: 0; opacity: 0.05; font-size: 5rem; transform: translate(20%, 20%);">
                <i class="fas fa-rupee-sign"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-orange">
                <i class="fas fa-box"></i>
            </div>
            <div class="stat-details">
                <h3>Total Products</h3>
                <div class="value"><%= productCount %></div>
            </div>
            <div style="position: absolute; right: 0; bottom: 0; opacity: 0.05; font-size: 5rem; transform: translate(20%, 20%);">
                <i class="fas fa-box"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-purple">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-details">
                <h3>Total Users</h3>
                <div class="value"><%= userCount %></div>
            </div>
            <div style="position: absolute; right: 0; bottom: 0; opacity: 0.05; font-size: 5rem; transform: translate(20%, 20%);">
                <i class="fas fa-users"></i>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2.5rem;">
        <div class="card" style="margin-bottom: 0;">
            <div class="card-header">
                <h3 class="card-title">Sales Overview</h3>
                <select class="form-control" style="width: auto; padding: 0.4rem 1rem; font-size: 0.85rem;">
                    <option>Last 7 Days</option>
                    <option>Last 30 Days</option>
                </select>
            </div>
            <canvas id="salesChart" height="120"></canvas>
        </div>

        <div class="card" style="margin-bottom: 0;">
            <div class="card-header">
                <h3 class="card-title">Recent Activity</h3>
            </div>
            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                <div style="display: flex; gap: 1rem; align-items: flex-start;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary-color); margin-top: 0.5rem;"></div>
                    <div>
                        <p style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.2rem;">New Order #<%= orderCount + 1024 %></p>
                        <p style="font-size: 0.85rem; color: var(--text-muted);">Just now • By Guest</p>
                    </div>
                </div>
                <div style="display: flex; gap: 1rem; align-items: flex-start;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; margin-top: 0.5rem;"></div>
                    <div>
                        <p style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.2rem;">Product Updated</p>
                        <p style="font-size: 0.85rem; color: var(--text-muted);">2 hours ago • By Admin</p>
                    </div>
                </div>
                <div style="display: flex; gap: 1rem; align-items: flex-start;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b; margin-top: 0.5rem;"></div>
                    <div>
                        <p style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.2rem;">Inventory Low</p>
                        <p style="font-size: 0.85rem; color: var(--text-muted);">5 hours ago • Bamboo Pen Stand</p>
                    </div>
                </div>
            </div>
            <button class="btn" style="width: 100%; margin-top: 2rem; background: #f8fafc; color: var(--text-muted); font-size: 0.85rem;">
                View All Activity
            </button>
        </div>
    </div>

    <script>
        const ctx = document.getElementById('salesChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Sales (₹)',
                    data: [12000, 19000, 15000, 25000, 22000, 30000, 45000],
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#10b981',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [5, 5], color: '#e2e8f0' },
                        ticks: { font: { family: 'Outfit' } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'Outfit' } }
                    }
                }
            }
        });
    </script>

<%- include('footer') %>