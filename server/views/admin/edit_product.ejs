<%- include('header', { path: '/products' , admin: admin }) %>

    <style>
        .image-preview-container {
            width: 100%;
            max-width: 300px;
            height: 200px;
            border: 2px dashed var(--border-color);
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-top: 10px;
            background-color: var(--bg-color);
            transition: var(--transition);
            position: relative;
        }

        .image-preview-container.has-image {
            border-style: solid;
            border-color: var(--primary-color);
            background-color: transparent;
        }

        .image-preview-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s;
        }

        .image-preview-container:hover img {
            transform: scale(1.05);
        }

        .form-group-interactive {
            position: relative;
            margin-bottom: 1.5rem;
        }

        .form-control-interactive {
            transition: all 0.3s;
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 0.5rem;
            background-color: #f8fafc;
            color: var(--text-main);
            font-family: inherit;
        }

        .form-control-interactive:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px var(--primary-light);
            outline: none;
            background-color: #fff;
        }

        .upload-btn-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
            margin-bottom: 10px;
        }

        .upload-btn-wrapper input[type=file] {
            font-size: 100px;
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
            cursor: pointer;
        }

        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <div style="margin-bottom: 20px; animation: fade-in 0.3s ease-out;">
        <a href="/admin/products"
            style="color: var(--text-muted); text-decoration: none; font-weight: 500; transition: color 0.3s;">
            <i class="fas fa-arrow-left" style="margin-right: 5px;"></i> Back to Products
        </a>
    </div>

    <div class="card" style="max-width: 800px; margin: 0 auto; animation: fade-in 0.5s ease-out;">
        <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
            <h2 style="margin: 0; color: var(--text-main);">Edit Product</h2>
        </div>

        <form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data"
            id="editProductForm">
            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Product Name</label>
                <input type="text" name="name" class="form-control-interactive" value="<%= product.name %>" required
                    placeholder="Enter product name">
            </div>

            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Description</label>
                <textarea name="description" class="form-control-interactive" rows="4" required
                    placeholder="Enter product description"><%= product.description %></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Original Price / MRP (₹)</label>
                    <input type="number" name="originalPrice" class="form-control-interactive" step="0.01"
                        value="<%= product.originalPrice || '' %>" placeholder="e.g. 700">
                    <small style="color: var(--text-muted); font-size: 0.8em; margin-top: 5px; display: block;">Leave blank if no discount.</small>
                </div>
                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Selling Price (₹)</label>
                    <input type="number" name="price" class="form-control-interactive" step="0.01"
                        value="<%= product.price %>" required placeholder="e.g. 500">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Discount Label</label>
                    <input type="text" name="discount" class="form-control-interactive"
                        value="<%= product.discount || '' %>" placeholder="e.g. '15% OFF', 'SALE', 'HOT'">
                </div>
                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Count In Stock</label>
                    <input type="number" name="countInStock" class="form-control-interactive"
                        value="<%= product.countInStock %>" required placeholder="e.g. 100">
                </div>
            </div>

            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Category</label>
                <select name="category" id="categorySelect" class="form-control-interactive" required
                    style="cursor: pointer;">
                    <option value="" disabled>Select a category</option>
                    <option value="bamboo"     <%= product.category === 'bamboo'      ? 'selected' : '' %>>Bamboo</option>
                    <option value="rugs"       <%= product.category === 'rugs'        ? 'selected' : '' %>>Rugs</option>
                    <option value="moonj-sikki"<%= product.category === 'moonj-sikki' ? 'selected' : '' %>>Moonj &amp; Sikki</option>
                    <option value="painting"   <%= product.category === 'painting'    ? 'selected' : '' %>>Painting</option>
                    <option value="apparel"    <%= product.category === 'apparel'     ? 'selected' : '' %>>Apparel</option>
                    <option value="khadi"      <%= product.category === 'khadi'       ? 'selected' : '' %>>Khadi</option>
                </select>
            </div>

            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Sub Category</label>
                <select name="subCategory" id="subCategorySelect" class="form-control-interactive"
                    style="cursor: pointer;">
                    <!-- Options populated by JS -->
                    <option value="<%= product.subCategory || '' %>"><%= product.subCategory || '— Select category first —' %></option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 2rem;">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Current Gallery</label>
                <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 15px;">
                    <% if (product.images && product.images.length > 0) { %>
                        <% product.images.forEach(function(img) { %>
                            <img src="<%= img %>" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color);" onerror="this.style.display='none'">
                        <% }); %>
                    <% } else { %>
                        <p style="color: var(--text-muted); font-size: 0.9em; margin: 0;">No images in gallery</p>
                    <% } %>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px; color: #ef4444; font-weight: 500; cursor: pointer; background: #fee2e2; padding: 10px; border-radius: 6px;">
                    <input type="checkbox" name="clearGallery" value="true">
                    Reset Gallery (Deletes all existing images on save)
                </label>

                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Append New Images</label>
                <div class="upload-btn-wrapper">
                    <button class="btn btn-primary" type="button"
                        style="background-color: var(--primary-light); color: var(--primary-dark); border: 1px solid var(--primary-color);">
                        <i class="fas fa-images" style="margin-right: 8px;"></i> Upload images
                    </button>
                    <input type="file" name="images" id="imageUpload" accept="image/*" multiple>
                </div>
                <p id="fileCountText" style="margin-top: 5px; color: var(--primary-color); font-weight: 500; display: none;">0 files selected</p>

                <p style="margin: 15px 0 8px 0; color: var(--text-muted); font-size: 0.9em; font-weight: 500;">Or enter new image URLs (one per line):</p>
                <textarea name="imageUrls" id="imageUrl" class="form-control-interactive" rows="4" placeholder="https://...
https://..."></textarea>
            </div>

            <!-- ── Product Detail Fields ─────────────────────────── -->
            <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 0.5rem;">
                <h3 style="font-size: 1rem; color: var(--text-main); margin-bottom: 1.5rem; font-weight: 600;">Product Detail Information</h3>

                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Material Used</label>
                    <input type="text" name="material" class="form-control-interactive"
                        value="<%= product.material || '' %>"
                        placeholder="e.g. Natural Bamboo, Jute, Moonj Grass">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                    <div class="form-group form-group-interactive">
                        <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Dimensions</label>
                        <input type="text" name="dimensions" class="form-control-interactive"
                            value="<%= product.dimensions || '' %>"
                            placeholder="e.g. 30cm Dia × 15cm H">
                    </div>
                    <div class="form-group form-group-interactive">
                        <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Components</label>
                        <input type="text" name="components" class="form-control-interactive"
                            value="<%= product.components || '' %>"
                            placeholder="e.g. 1× Handcrafted basket + lid">
                    </div>
                </div>

                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Eco-Friendly Green Features</label>
                    <textarea name="ecoFeatures" class="form-control-interactive" rows="4"
                        placeholder="Enter eco-friendly highlights, one per line."><%= product.ecoFeatures || '' %></textarea>
                    <small style="color: var(--text-muted); font-size: 0.8em;">Enter one feature per line — they appear as bullet points on the product page.</small>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                    <div class="form-group form-group-interactive">
                        <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Country of Origin</label>
                        <input type="text" name="countryOfOrigin" class="form-control-interactive"
                            value="<%= product.countryOfOrigin || 'India' %>"
                            placeholder="e.g. India">
                    </div>
                    <div class="form-group form-group-interactive">
                        <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Artisan Image URL</label>
                        <input type="url" name="artisanImageUrl" class="form-control-interactive"
                            value="<%= product.artisanImage || '' %>"
                            placeholder="https://... (photo of artisan making product)">
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" id="submitBtn"
                style="width: 100%; font-size: 1.1em; padding: 1rem; transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px;">
                <i class="fas fa-save"></i> Update Product
            </button>
        </form>
    </div>

    <script>
        const subCategoryMap = {
            'bamboo':      ['lantern', 'jewellery-cosmetic-box', 'laundry-bag', 'pen-stand', 'utility-box', 'tokri', 'wall-hanging'],
            'rugs':        ['doormat', 'aasan', 'yoga-mat', 'runner', 'floor-rugs'],
            'moonj-sikki': ['jewellery-cosmetic-box', 'laundry-bag', 'pen-stand', 'utility-box', 'tokri', 'wall-hanging', 'lantern'],
            'painting':    ['madhubani', 'warli', 'miniature', 'pattachitra', 'other'],
            'apparel':     ['shirts', 'pants', 'silk-fabric', 'cotton-fabric', 'dupatta', 'saree'],
            'khadi':       ['shirts', 'pants', 'silk-fabric', 'cotton-fabric', 'kurta', 'fabric-roll'],
        };

        const categorySelect    = document.getElementById('categorySelect');
        const subCategorySelect = document.getElementById('subCategorySelect');
        const currentSubCat     = '<%= product.subCategory || "" %>';

        function populateSubCategories(selectedCategory, currentValue) {
            subCategorySelect.innerHTML = '';
            const subs = subCategoryMap[selectedCategory] || [];
            if (subs.length === 0) {
                subCategorySelect.innerHTML = '<option value="">— No subcategories —</option>';
                return;
            }
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '— Select subcategory —';
            subCategorySelect.appendChild(placeholder);
            subs.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
                if (currentValue && sub === currentValue) opt.selected = true;
                subCategorySelect.appendChild(opt);
            });
        }

        // Populate on load using existing product values
        if (categorySelect.value) populateSubCategories(categorySelect.value, currentSubCat);

        categorySelect.addEventListener('change', () => {
            populateSubCategories(categorySelect.value, null);
        });

        const imageUpload   = document.getElementById('imageUpload');
        const fileCountText = document.getElementById('fileCountText');
        const submitBtn     = document.getElementById('submitBtn');

        imageUpload.addEventListener('change', function () {
            if (this.files && this.files.length > 0) {
                fileCountText.style.display = 'block';
                fileCountText.textContent = this.files.length + ' file(s) selected automatically.';
            } else {
                fileCountText.style.display = 'none';
            }
        });

        submitBtn.addEventListener('mousedown',  () => submitBtn.style.transform = 'scale(0.98)');
        submitBtn.addEventListener('mouseup',    () => submitBtn.style.transform = 'scale(1)');
        submitBtn.addEventListener('mouseleave', () => submitBtn.style.transform = 'scale(1)');

        document.querySelectorAll('.form-control-interactive').forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.style.transform  = 'translateY(-2px)';
                input.parentElement.style.transition = 'transform 0.3s';
            });
            input.addEventListener('blur', () => {
                input.parentElement.style.transform = 'translateY(0)';
            });
        });
    </script>

    <%- include('footer') %>