<%- include('header', { path: '/products' , admin: admin }) %>

    <style>
        .image-preview-container {
            width: 100%;
            max-width: 300px;
            height: 200px;
            border: 2px dashed var(--border-color);
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-top: 10px;
            background-color: var(--bg-color);
            transition: var(--transition);
            position: relative;
        }

        .image-preview-container.has-image {
            border-style: solid;
            border-color: var(--primary-color);
            background-color: transparent;
        }

        .image-preview-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s;
        }

        .image-preview-container:hover img {
            transform: scale(1.05);
        }

        .form-group-interactive {
            position: relative;
            margin-bottom: 1.5rem;
        }

        .form-control-interactive {
            transition: all 0.3s;
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 0.5rem;
            background-color: #f8fafc;
            color: var(--text-main);
            font-family: inherit;
        }

        .form-control-interactive:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px var(--primary-light);
            outline: none;
            background-color: #fff;
        }

        .upload-btn-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
            margin-bottom: 10px;
        }

        .upload-btn-wrapper input[type=file] {
            font-size: 100px;
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
            cursor: pointer;
        }

        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <div style="margin-bottom: 20px; animation: fade-in 0.3s ease-out;">
        <a href="/admin/products"
            style="color: var(--text-muted); text-decoration: none; font-weight: 500; transition: color 0.3s;">
            <i class="fas fa-arrow-left" style="margin-right: 5px;"></i> Back to Products
        </a>
    </div>

    <div class="card" style="max-width: 800px; margin: 0 auto; animation: fade-in 0.5s ease-out;">
        <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
            <h2 style="margin: 0; color: var(--text-main);">Edit Product</h2>
        </div>

        <form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data"
            id="editProductForm">
            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Product Name</label>
                <input type="text" name="name" class="form-control-interactive" value="<%= product.name %>" required
                    placeholder="Enter product name">
            </div>

            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Description</label>
                <textarea name="description" class="form-control-interactive" rows="4" required
                    placeholder="Enter product description"><%= product.description %></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Price (₹)</label>
                    <input type="number" name="price" class="form-control-interactive" step="0.01"
                        value="<%= product.price %>" required placeholder="e.g. 500">
                </div>
                <div class="form-group form-group-interactive">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Count In Stock</label>
                    <input type="number" name="countInStock" class="form-control-interactive"
                        value="<%= product.countInStock %>" required placeholder="e.g. 100">
                </div>
            </div>

            <div class="form-group form-group-interactive">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Category</label>
                <input type="text" name="category" class="form-control-interactive" value="<%= product.category %>"
                    required list="category-list" placeholder="Select or type category">
                <datalist id="category-list">
                    <option value="bamboo">
                    <option value="rugs">
                    <option value="khadi">
                    <option value="moonj-sikki">
                    <option value="painting">
                    <option value="apparel">
                </datalist>
            </div>

            <div class="form-group" style="margin-bottom: 2rem;">
                <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Product Image</label>
                <div class="upload-btn-wrapper">
                    <button class="btn btn-primary" type="button"
                        style="background-color: var(--primary-light); color: var(--primary-dark); border: 1px solid var(--primary-color);">
                        <i class="fas fa-cloud-upload-alt" style="margin-right: 8px;"></i> Upload new image
                    </button>
                    <input type="file" name="image" id="imageUpload" accept="image/*">
                </div>
                <p style="margin: 8px 0; color: var(--text-muted); font-size: 0.9em; font-weight: 500;">Or enter image
                    URL:</p>
                <input type="text" name="image" id="imageUrl" class="form-control-interactive"
                    value="<%= product.image %>" placeholder="http://...">

                <div class="image-preview-container <%= product.image ? 'has-image' : '' %>" id="imagePreviewContainer">
                    <img id="imagePreview" src="<%= product.image %>" alt="Product Preview"
                        style="<%= product.image ? 'display: block;' : 'display: none;' %>"
                        onerror="this.style.display='none'; document.getElementById('imagePreviewText').style.display='block'; document.getElementById('imagePreviewContainer').classList.remove('has-image');">
                    <span id="imagePreviewText"
                        style="color: var(--text-muted); font-weight: 500; <%= product.image ? 'display: none;' : 'display: block;' %>">
                        <i class="fas fa-image"
                            style="font-size: 2rem; display: block; margin-bottom: 10px; opacity: 0.5;"></i>
                        No image selected
                    </span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" id="submitBtn"
                style="width: 100%; font-size: 1.1em; padding: 1rem; transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px;">
                <i class="fas fa-save"></i> Update Product
            </button>
        </form>
    </div>

    <script>
        const imageUpload = document.getElementById('imageUpload');
        const imageUrl = document.getElementById('imageUrl');
        const imagePreview = document.getElementById('imagePreview');
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');
        const imagePreviewText = document.getElementById('imagePreviewText');
        const submitBtn = document.getElementById('submitBtn');

        function updateImagePreview(src) {
            if (src) {
                imagePreview.src = src;
                imagePreview.style.display = 'block';
                imagePreviewText.style.display = 'none';
                imagePreviewContainer.classList.add('has-image');
            } else {
                imagePreview.src = '';
                imagePreview.style.display = 'none';
                imagePreviewText.style.display = 'block';
                imagePreviewContainer.classList.remove('has-image');
            }
        }

        imageUpload.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    updateImagePreview(e.target.result);
                    imageUrl.value = ''; // clear url input
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        imageUrl.addEventListener('input', function () {
            if (this.value) {
                updateImagePreview(this.value);
                imageUpload.value = ''; // clear file input
            } else {
                updateImagePreview('');
            }
        });

        // Check initial image load failure
        if (imagePreview.src && imagePreview.src !== window.location.href) {
            const img = new Image();
            img.onerror = function () {
                imagePreview.style.display = 'none';
                imagePreviewText.style.display = 'block';
                imagePreviewContainer.classList.remove('has-image');
            };
            img.src = imagePreview.src;
        }

        // Button interactions for tactile feel
        submitBtn.addEventListener('mousedown', () => submitBtn.style.transform = 'scale(0.98)');
        submitBtn.addEventListener('mouseup', () => submitBtn.style.transform = 'scale(1)');
        submitBtn.addEventListener('mouseleave', () => submitBtn.style.transform = 'scale(1)');

        // Add interaction to inputs for better UX
        const inputs = document.querySelectorAll('.form-control-interactive');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.style.transform = 'translateY(-2px)';
                input.parentElement.style.transition = 'transform 0.3s';
            });
            input.addEventListener('blur', () => {
                input.parentElement.style.transform = 'translateY(0)';
            });
        });
    </script>

    <%- include('footer') %>