<%- include('header', { path: '/products' , admin: admin, title: 'Manage Products' }) %>

    <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h2 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 0.5rem; color: var(--secondary-color);">Product Management</h2>
            <p style="color: var(--text-muted); font-size: 1rem;">View, edit, and manage your store's inventory.</p>
        </div>
        <a href="/admin/products/add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Product
        </a>
    </div>

    <div class="card" style="padding: 0; overflow: hidden; border-radius: 1.25rem;">
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th style="width: 80px; text-align: center;">Preview</th>
                        <th>Product Details</th>
                        <th>Price</th>
                        <th>Stock Status</th>
                        <th>Category</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <tr>
                                <td style="text-align: center;">
                                    <div style="width: 50px; height: 50px; border-radius: 12px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: #f8fafc; border: 1px solid var(--border-color); margin: 0 auto;">
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                                        <% } else { %>
                                            <i class="fas fa-image" style="color: var(--text-muted); opacity: 0.5;"></i>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: var(--secondary-color); margin-bottom: 0.2rem;"><%= product.name %></div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted); font-family: monospace;"><%= product._id %></div>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: var(--primary-dark);">₹<%= product.price.toLocaleString('en-IN') %></div>
                                </td>
                                <td>
                                    <% if (product.countInStock > 10) { %>
                                        <span style="display: inline-flex; align-items: center; gap: 0.4rem; color: #10b981; font-weight: 700; font-size: 0.85rem; padding: 0.35rem 0.75rem; background: #ecfdf5; border-radius: 9999px;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
                                            In Stock (<%= product.countInStock %>)
                                        </span>
                                    <% } else if (product.countInStock > 0) { %>
                                        <span style="display: inline-flex; align-items: center; gap: 0.4rem; color: #f59e0b; font-weight: 700; font-size: 0.85rem; padding: 0.35rem 0.75rem; background: #fffbeb; border-radius: 9999px;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: #f59e0b;"></span>
                                            Low Stock (<%= product.countInStock %>)
                                        </span>
                                    <% } else { %>
                                        <span style="display: inline-flex; align-items: center; gap: 0.4rem; color: #ef4444; font-weight: 700; font-size: 0.85rem; padding: 0.35rem 0.75rem; background: #fef2f2; border-radius: 9999px;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: #ef4444;"></span>
                                            Out of Stock
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <span style="text-transform: capitalize; font-weight: 600; font-size: 0.85rem; color: var(--text-muted);">
                                        <%= product.category %>
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                        <a href="/admin/products/edit/<%= product._id %>" class="btn" style="padding: 0.6rem; background: #f1f5f9; color: var(--text-muted);">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/admin/products/delete/<%= product._id %>" class="btn" style="padding: 0.6rem; background: #fee2e2; color: #ef4444;" onclick="return confirm('Delete this product permanently?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 5rem 1rem;">
                                <div style="width: 80px; height: 80px; background: #f8fafc; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                                    <i class="fas fa-box-open" style="font-size: 2.5rem; color: var(--border-color);"></i>
                                </div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 0.5rem;">No products found</h3>
                                <p style="color: var(--text-muted);">Your inventory is currently empty.</p>
                                <a href="/admin/products/add" class="btn btn-primary" style="margin-top: 1.5rem;">Add Your First Product</a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

<%- include('footer') %>