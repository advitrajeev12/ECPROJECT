<%- include('header', { path: '/products' , admin: admin }) %>

    <div class="card-header" style="margin-bottom: 2rem; border-bottom: none; padding-bottom: 0;">
        <h2 style="font-size: 1.75rem; color: var(--text-main); margin: 0;">Product Management</h2>
        <a href="/admin/products/add" class="btn btn-primary">
            <i class="fas fa-plus" style="margin-right: 0.5rem;"></i> Add New Product
        </a>
    </div>

    <div class="card table-responsive" style="padding: 0; overflow: hidden;">
        <table>
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (products.length> 0) { %>
                    <% products.forEach(product=> { %>
                        <tr>
                            <td style="font-weight: 500;">
                                <%= product.name %>
                            </td>
                            <td style="color: var(--primary-color); font-weight: 600;">$<%= product.price %>
                            </td>
                            <td>
                                <span
                                    style="background: var(--bg-color); padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.85rem; color: var(--text-muted); border: 1px solid var(--border-color);">
                                    <%= product.category %>
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <a href="/admin/products/edit/<%= product._id %>" class="btn"
                                    style="padding: 0.5rem; color: var(--text-muted); background: var(--bg-color);">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/admin/products/delete/<%= product._id %>" class="btn"
                                    style="padding: 0.5rem; margin-left: 0.5rem; color: #ef4444; background: #fee2e2;"
                                    onclick="return confirm('Are you sure you want to delete this product?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4"
                                        style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                                        <i class="fas fa-box-open"
                                            style="font-size: 3rem; margin-bottom: 1rem; color: var(--border-color);"></i>
                                        <p style="font-size: 1.1rem; font-weight: 500;">No products found.</p>
                                        <p style="font-size: 0.9rem;">Start adding items to your inventory.</p>
                                    </td>
                                </tr>
                                <% } %>
            </tbody>
        </table>
    </div>

    <%- include('footer') %>