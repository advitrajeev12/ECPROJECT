<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Signup - Baljyoti Indegenous</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon" style="background: #e0f2fe; color: #0284c7;">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2 class="auth-title">Create Admin</h2>
            <p class="auth-subtitle">Register a new administrator account.</p>
        </div>

        <% if (error) { %>
            <div class="error-alert">
                <i class="fas fa-exclamation-circle"></i>
                <span>
                    <%= error %>
                </span>
            </div>
            <% } %>

                <form action="/admin/signup" method="POST">
                    <div class="form-group">
                        <label>Email Address</label>
                        <div style="position: relative;">
                            <i class="fas fa-envelope"
                                style="position: absolute; left: 1rem; top: 1rem; color: var(--text-muted);"></i>
                            <input type="email" name="email" class="form-control" required
                                placeholder="admin@example.com" style="padding-left: 2.75rem;">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <div style="position: relative;">
                            <i class="fas fa-lock"
                                style="position: absolute; left: 1rem; top: 1rem; color: var(--text-muted);"></i>
                            <input type="password" name="password" class="form-control" required placeholder="••••••••"
                                style="padding-left: 2.75rem;">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem;">
                        Create Account <i class="fas fa-check" style="margin-left: 8px;"></i>
                    </button>
                </form>

                <div class="auth-footer">
                    <span style="color: var(--text-muted); font-size: 0.95rem;">Already have an account?</span>
                    <a href="/admin/login" class="auth-link" style="margin-left: 0.25rem;">Login here</a>
                </div>
    </div>
</body>

</html>