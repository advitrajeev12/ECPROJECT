<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Dashboard | The Loom</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1a5d1a',
                        secondary: '#5d4037',
                        accent: '#d97706',
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50/50 min-h-screen">
    <!-- Navbar -->
    <!-- Navbar (Matched with Client) -->
    <nav class="bg-white shadow-md py-4 px-6 flex justify-between items-center border-b relative">
        <!-- Logo -->
        <div class="flex items-center gap-2">
            <a href="http://172.20.10.2:3000/">
                <img src="/images/logo.png" alt="Baljyoti Indegenous" class="h-10">
            </a>
            <a href="http://172.20.10.2:3000/"
                class="font-serif text-xl font-bold tracking-wide text-primary hidden md:block">
                Baljyoti Indegenous
            </a>
        </div>

        <!-- Navigation Links -->
        <ul class="hidden md:flex gap-8 items-center flex-wrap justify-center">
            <li>
                <a href="http://172.20.10.2:3000/productcategories/rugs"
                    class="text-gray-700 font-medium text-[15px] tracking-wide px-1 py-1 transition-all duration-300 hover:text-primary relative group">
                    Rugs
                    <span
                        class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
            </li>
            <li class="relative group">
                <button
                    class="flex items-center gap-1 text-gray-700 font-medium text-[15px] tracking-wide px-1 py-1 transition-all duration-300 hover:text-primary">
                    Crafts <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </button>
                <!-- Dropdown -->
                <div
                    class="absolute top-full left-0 mt-0 w-48 bg-white shadow-xl rounded-md border border-gray-100 py-2 z-50 hidden group-hover:block">
                    <a href="http://172.20.10.2:3000/productcategories/moonj-sikki"
                        class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors border-b border-gray-50">Moonj
                        & Sikki</a>
                    <a href="http://172.20.10.2:3000/productcategories/bamboo"
                        class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors border-b border-gray-50">Bamboo</a>
                    <a href="http://172.20.10.2:3000/productcategories/crochet"
                        class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors">Crochet</a>
                </div>
            </li>
            <li>
                <a href="http://172.20.10.2:3000/productcategories/apparel"
                    class="text-gray-700 font-medium text-[15px] tracking-wide px-1 py-1 transition-all duration-300 hover:text-primary relative group">
                    Apparels
                    <span
                        class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
            </li>
            <li>
                <a href="http://172.20.10.2:3000/productcategories/painting"
                    class="text-gray-700 font-medium text-[15px] tracking-wide px-1 py-1 transition-all duration-300 hover:text-primary relative group">
                    Painting
                    <span
                        class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
            </li>
            <li>
                <a href="http://172.20.10.2:3000/productcategories/khadi"
                    class="text-gray-700 font-medium text-[15px] tracking-wide px-1 py-1 transition-all duration-300 hover:text-primary relative group">
                    Khadi
                    <span
                        class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
            </li>
            <li>
                <a href="http://172.20.10.2:3000/bulk-orders"
                    class="text-gray-700 font-medium text-[15px] tracking-wide px-1 py-1 transition-all duration-300 hover:text-primary relative group">
                    Bulk Order Query
                    <span
                        class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
            </li>
        </ul>

        <!-- Icons -->
        <div class="flex space-x-4 items-center relative z-50">
            <div class="flex items-center gap-2">
                <i data-lucide="search" class="w-5 h-5 cursor-pointer hover:text-primary transition-colors"></i>
            </div>

            <a href="http://172.20.10.2:3000/user/wishlist">
                <i data-lucide="heart" class="w-5 h-5 cursor-pointer hover:text-red-500 transition-colors"></i>
            </a>

            <!-- User Dropdown -->
            <div class="relative group">
                <div class="flex items-center gap-2 cursor-pointer pb-2 pt-2">
                    <span class="text-sm font-medium text-gray-700 hidden md:block select-none">
                        <%= user.name.split(' ')[0] %>
                    </span>
                    <i data-lucide="user" class="w-5 h-5 text-gray-700 group-hover:text-primary transition-colors"></i>
                </div>
                <!-- Dropdown Menu -->
                <div class="absolute top-full right-0 mt-0 w-48 bg-white shadow-xl rounded-md border border-gray-100 py-2 z-50 hidden group-hover:block">
                    <div class="absolute top-0 right-4 -mt-2 w-4 h-4 bg-white transform rotate-45 border-t border-l border-gray-100"></div>
                    <div class="px-4 py-3 border-b border-gray-100 mb-1">
                        <p class="text-sm font-medium text-gray-900 truncate"><%= user.name %></p>
                        <p class="text-xs text-gray-500 truncate"><%= user.email %></p>
                    </div>
                    <a href="/user/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors">My Profile</a>
                    <a href="http://172.20.10.2:3000/user/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors">My Orders</a>
                    <a href="http://172.20.10.2:3000/user/wishlist" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors">Wishlist</a>
                    <div class="border-t border-gray-100 my-1"></div>
                    <a href="/user/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors flex items-center gap-2">
                        <i data-lucide="log-out" class="w-4 h-4"></i> Logout
                    </a>
                </div>
            </div>

            <a href="http://172.20.10.2:3000/user/cart" class="relative group" title="View Bag">
                <i data-lucide="shopping-cart" class="w-5 h-5 cursor-pointer hover:text-primary transition-colors"></i>
                <!-- Cart count could be passed from server if available, currently omitted -->
            </a>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col md:flex-row gap-8">
            <!-- Sidebar Navigation -->
            <div class="w-full md:w-80 flex-shrink-0">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden sticky top-24">
                    <div class="p-6 bg-gradient-to-br from-primary/5 to-primary/10 border-b border-gray-100">
                        <div class="flex items-center gap-4">
                            <div
                                class="w-14 h-14 rounded-full bg-white flex items-center justify-center text-primary text-xl font-bold shadow-sm border border-gray-100 uppercase">
                                <%= user.name.charAt(0) %>
                            </div>
                            <div class="overflow-hidden">
                                <h2 class="font-bold text-gray-900 truncate">
                                    <%= user.name %>
                                </h2>
                                <p class="text-xs text-gray-500 truncate">
                                    <%= user.email %>
                                </p>
                                <div
                                    class="mt-2 inline-flex px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-[10px] font-bold uppercase tracking-wide">
                                    Verified Account
                                </div>
                            </div>
                        </div>
                    </div>

                    <nav class="p-4 space-y-1.5" id="nav-menu">
                        <p class="px-3 py-2 text-xs font-bold text-gray-400 uppercase tracking-wider">Menu</p>

                        <a href="/user/dashboard"
                            class="w-full flex items-center gap-3 px-3 py-3 text-sm font-medium rounded-xl transition-all duration-200 bg-primary text-white shadow-lg shadow-primary/25">
                            <i data-lucide="user" class="w-5 h-5"></i>
                            My Profile
                        </a>

                        <a href="#"
                            class="w-full flex items-center gap-3 px-3 py-3 text-sm font-medium rounded-xl transition-all duration-200 text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                            <i data-lucide="package" class="w-5 h-5"></i>
                            My Orders
                        </a>

                        <a href="#"
                            class="w-full flex items-center gap-3 px-3 py-3 text-sm font-medium rounded-xl transition-all duration-200 text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                            <i data-lucide="heart" class="w-5 h-5"></i>
                            Wishlist
                        </a>

                        <div class="my-4 border-t border-gray-100 mx-3"></div>

                        <a href="/user/logout"
                            class="w-full flex items-center gap-3 px-3 py-3 text-sm font-medium text-rose-600 rounded-xl hover:bg-rose-50 transition-colors group">
                            <i data-lucide="log-out" class="w-5 h-5 group-hover:scale-110 transition-transform"></i>
                            Logout
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="flex-1 min-h-[600px] transition-all duration-300">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <!-- Cover Banner -->
                    <div class="h-32 bg-gradient-to-r from-primary/80 to-primary/40 relative"></div>

                    <div class="px-8 pb-8">
                        <div class="relative flex justify-between items-end -mt-12 mb-6">
                            <div class="flex items-end gap-4">
                                <div class="relative">
                                    <div class="w-24 h-24 rounded-full bg-white p-1 shadow-lg">
                                        <div
                                            class="w-full h-full rounded-full bg-gray-100 flex items-center justify-center text-primary text-3xl font-bold uppercase">
                                            <%= user.name.charAt(0) %>
                                        </div>
                                    </div>
                                    <button
                                        class="absolute bottom-0 right-0 p-1.5 bg-primary text-white rounded-full hover:bg-primary/90 transition-colors shadow-md">
                                        <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                                <div class="mb-2">
                                    <h2 class="text-2xl font-bold text-gray-900">
                                        <%= user.name %>
                                    </h2>
                                    <p class="text-gray-500">
                                        <%= user.email %>
                                    </p>
                                </div>
                            </div>
                            <button
                                class="px-4 py-2 text-sm font-medium text-primary border border-primary rounded-lg hover:bg-primary hover:text-white transition-colors">
                                Edit Profile
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
                            <div class="space-y-6">
                                <h3 class="text-lg font-semibold text-gray-900 border-b pb-2">Personal Information</h3>
                                <div class="space-y-4">
                                    <div>
                                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Full
                                            Name</label>
                                        <p class="text-gray-900 font-medium mt-1">
                                            <%= user.name %>
                                        </p>
                                    </div>
                                    <div>
                                        <label
                                            class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Email
                                            Address</label>
                                        <p class="text-gray-900 font-medium mt-1">
                                            <%= user.email %>
                                        </p>
                                    </div>
                                    <div>
                                        <label
                                            class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Mobile
                                            Number</label>
                                        <p class="text-gray-900 font-medium mt-1">
                                            <%= user.mobile || "Not provided" %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-6">
                                <h3 class="text-lg font-semibold text-gray-900 border-b pb-2">Account Settings</h3>
                                <div class="space-y-3">
                                    <button
                                        class="w-full flex items-center justify-between p-3 rounded-lg border border-gray-100 hover:bg-gray-50 transition-colors group">
                                        <span class="text-gray-700 font-medium">Change Password</span>
                                        <i data-lucide="chevron-right"
                                            class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors"></i>
                                    </button>
                                    <button
                                        class="w-full flex items-center justify-between p-3 rounded-lg border border-gray-100 hover:bg-gray-50 transition-colors group">
                                        <span class="text-gray-700 font-medium">Notification Preferences</span>
                                        <i data-lucide="chevron-right"
                                            class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        lucide.createIcons();
    </script>
</body>

</html>